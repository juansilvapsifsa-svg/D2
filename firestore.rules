rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Room rules
    match /rooms/{roomId} {
      allow get: if true; // Public access to join via code
      allow list: if false; // No listing rooms

      allow create: if isSignedIn() 
        && incoming().id == roomId
        && incoming().status == 'waiting'
        && incoming().players.p1 == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn() && (
          // Action: Join Room
          (existing().status == 'waiting' && incoming().status == 'playing' && incoming().players.p2 == request.auth.uid) ||
          // Action: Game State Update (if player is part of the room)
          (isSignedIn() && (existing().players.p1 == request.auth.uid || existing().players.p2 == request.auth.uid))
        )
        && incoming().updatedAt == request.time
      );
    }
  }
}
